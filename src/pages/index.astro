---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FaqItem from "../components/FaqItem.astro";
import LaunchListForm from "../components/LaunchListForm.astro";
import OperationPlaceholder from "../components/OperationPlaceholder.astro";
import { withBase } from "../utils/paths";
import {
  audiences,
  careerEvents,
  careerLoop,
  careerPath,
  faqItems,
  integrationSteps,
  missionFiles,
  operationFeatures,
  productPrinciples,
  productStats,
  progressionRequirements,
} from "../data/home";
---

<BaseLayout
  title="Pilot Journey | From student pilot to the left seat"
  description="Build a persistent aviation career through contracts, assigned operations and progression for Microsoft Flight Simulator."
>
  <section class="hero" aria-labelledby="hero-title">
    <span class="hero-aircraft" aria-hidden="true">✈</span>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker">
          <Eyebrow label="Career operations for flight simmers" light />
        </div>

        <div class="hero-brand">
          <h1 id="hero-title">
            <span>Pilot</span>
            <strong>Journey</strong>
          </h1>
          <div class="hero-route-detail" aria-hidden="true"><i></i></div>
        </div>

        <p class="hero-payoff">From student pilot to the left seat.</p>
        <p class="hero-lede">
          Fly the contracts. Earn the ratings. Build a career that continues after every flight.
        </p>

        <div class="button-row">
          <Button href="#launch-access" variant="primary" arrow>Join the launch list</Button>
          <Button href="#operations" variant="ghost">Review the operation</Button>
        </div>

        <dl class="hero-manifest" aria-label="Product coverage">
          {productStats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero-visual" data-hero-visual>
        <div class="app-frame">
          <div class="window-bar" aria-hidden="true">
            <div><i></i><i></i><i></i></div>
            <span>Pilot Journey / Mailbox</span>
          </div>
          <img
            src={withBase("/media/pilot-journey-app.png")}
            alt="Pilot Journey mailbox with an airline contract offer"
            width="1600"
            height="1013"
            fetchpriority="high"
          />
        </div>

        <div class="flight-slip">
          <span>Next operation</span>
          <div>
            <strong class="airport-code">KORD</strong>
            <i aria-hidden="true">→</i>
            <strong class="airport-code">KACY</strong>
          </div>
          <small>Flight NKS943 · Assigned</small>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="section mission-section" aria-labelledby="mission-title">
    <div class="container">
      <div class="section-heading split-heading" data-reveal>
        <div>
          <Eyebrow label="Mission profile" />
          <h2 id="mission-title" class="section-title">Your logbook becomes a career.</h2>
        </div>
        <p class="section-lede">
          Pilot Journey turns every simulator session into part of a larger operation. Applications, assignments,
          aircraft, performance and progression remain connected from one flight to the next.
        </p>
      </div>

      <div class="mission-files">
        {missionFiles.map((file, index) => (
          <article class={`mission-file file-${index + 1}`} data-reveal>
            <div class="file-register">
              <span>FILE {file.number}</span>
              <span>{file.register}</span>
            </div>
            <h3>{file.title}</h3>
            <p>{file.copy}</p>
            <div class="file-mark" aria-hidden="true">{file.number}</div>
          </article>
        ))}
      </div>

      <p class="mission-statement" data-reveal>
        <span aria-hidden="true">“</span>
        You are not selecting random flights. You are building a career.
      </p>
    </div>
  </section>

  <section id="career-loop" class="section career-loop-section passport-grid" aria-labelledby="loop-title">
    <div class="container">
      <div class="dark-heading" data-reveal>
        <Eyebrow label="The career loop" light />
        <h2 id="loop-title" class="section-title">One flight leads to the next.</h2>
      </div>

      <ol class="career-route" aria-label="The Pilot Journey career loop">
        {careerLoop.map((step) => (
          <li data-reveal>
            <div class="route-marker">
              <span>{step.number}</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="route-copy">
              <small>{step.status}</small>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="route-conclusion" data-reveal>
        <span>OPERATIONAL EFFECT</span>
        <p>Every operation changes what becomes available next.</p>
      </div>
    </div>
  </section>

  <section id="operations" class="section operations-section" aria-labelledby="operations-title">
    <div class="container">
      <div class="operations-intro" data-reveal>
        <div>
          <Eyebrow label="Operations console" />
          <h2 id="operations-title" class="section-title">
            Everything your career needs, in one command center.
          </h2>
        </div>
        <p class="section-lede">
          Begin with the assignment in front of you. The console keeps the contract, airline, route, performance and
          career behind it connected.
        </p>
      </div>

      <figure class="console-overview" data-reveal>
        <div class="console-bar">
          <div><i></i><i></i><i></i></div>
          <span>OPERATIONS CONSOLE / MAILBOX</span>
          <small>CONNECTED CAREER RECORD</small>
        </div>
        <img
          src={withBase("/media/pilot-journey-app.png")}
          alt="Pilot Journey operations console showing the operational mailbox"
          width="1600"
          height="1013"
          loading="lazy"
        />
        <figcaption>
          <span>LIVE PRODUCT VIEW</span>
          <p>Contract mail, career notices and operational decisions share one environment.</p>
        </figcaption>
      </figure>

      <!-- TODO(content): replace every data-screenshot-placeholder interface with its final product screenshot. -->
      <div class="operation-stories">
        {operationFeatures.map((feature, index) => (
          <article class:list={["operation-story", { "story-reverse": index % 2 === 1 }]} data-reveal>
            <div class="story-copy">
              <span class="story-register">{feature.register}</span>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
              <div class="story-index">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <i aria-hidden="true"></i>
                <small>CAREER SYSTEM</small>
              </div>
            </div>

            <div class="story-visual">
              {
                feature.visual === "screenshot" ? (
                  <figure class="mailbox-window">
                    <div class="console-bar">
                      <div><i></i><i></i><i></i></div>
                      <span>OPERATIONAL MAILBOX</span>
                      <small>PRODUCT SCREEN</small>
                    </div>
                    <img
                      src={withBase("/media/pilot-journey-app.png")}
                      alt="Operational mailbox with messages from airlines, operations and training"
                      width="1600"
                      height="1013"
                      loading="lazy"
                    />
                  </figure>
                ) : (
                  <OperationPlaceholder variant={feature.visual} title={feature.title} />
                )
              }
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section events-section" aria-labelledby="events-title">
    <div class="container">
      <div class="events-heading" data-reveal>
        <div>
          <Eyebrow label="Career events" />
          <h2 id="events-title" class="section-title">The operation does not stand still.</h2>
        </div>
        <p class="section-lede">
          Airline life is shaped by more than flight hours. Pilot Journey introduces events, communication and
          decisions that make each career feel personal.
        </p>
      </div>

      <div class="events-layout">
        <article class="event-mail" data-reveal>
          <div class="mail-head">
            <div class="mail-sender">FO</div>
            <div><strong>Flight Operations</strong><span>operations@airline.ops</span></div>
            <small>IN-GAME EVENT</small>
          </div>
          <div class="mail-routing">
            <span>FROM</span><b>Flight Operations</b>
            <span>SUBJECT</span><b>Fleet transition opportunity</b>
            <span>STATUS</span><i>ACTION REQUIRED</i>
          </div>
          <h3>Fleet transition opportunity</h3>
          <p>
            Due to upcoming network changes, qualified pilots may request transition training for the A321 fleet.
          </p>
          <div class="mail-actions">
            <span>REVIEW REQUIREMENTS</span>
            <span>DECISION PENDING</span>
          </div>
        </article>

        <div class="event-register" data-reveal>
          <div class="register-head"><span>EVENT REGISTER</span><b>06 CATEGORIES</b></div>
          {careerEvents.map((event, index) => (
            <article class={`event-row event-${event.type}`}>
              <span>{event.code}</span>
              <h3>{event.title}</h3>
              <small>{String(index + 1).padStart(2, "0")}</small>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="career" class="section career-path-section" aria-labelledby="career-title">
    <div class="container">
      <div class="career-path-heading" data-reveal>
        <div>
          <Eyebrow label="Career path" />
          <h2 id="career-title" class="section-title">Earn the seat. Do not simply select it.</h2>
        </div>
        <p class="section-lede">
          Your next position is determined by what you have achieved, not by a dropdown menu.
        </p>
      </div>

      <ol class="career-timeline">
        {careerPath.map((stage, index) => (
          <li data-reveal>
            <div class="career-node"><span>{stage.code}</span></div>
            <div class="career-stage">
              <small>STAGE {String(index + 1).padStart(2, "0")}</small>
              <h3>{stage.title}</h3>
              <p>{stage.gate}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="requirements-strip" data-reveal>
        <span>ACCESS MAY DEPEND ON</span>
        <ul>
          {progressionRequirements.map((requirement) => <li>{requirement}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section global-section passport-grid" aria-labelledby="global-title">
    <div class="container global-grid">
      <div class="global-copy" data-reveal>
        <Eyebrow label="Global operations" light />
        <h2 id="global-title" class="section-title">A career without a fixed horizon.</h2>
        <p class="section-lede">
          Move between operators, aircraft families, bases and regions as your experience grows. Each choice becomes
          part of your personal aviation history.
        </p>

        <dl class="global-stats">
          {productStats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="network-board" data-reveal>
        <img
          src={withBase("/media/pilot-journey-live-flight.png")}
          alt="Pilot Journey Live Flight screen showing VLG3342 from Rome to Zakynthos on a satellite route map"
          width="1666"
          height="1028"
          loading="lazy"
        />
        <figcaption>
          <span>LIVE PRODUCT VIEW</span>
          <small>VLG3342 · LIRF → LGZA · A320ceo</small>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section integration-section" aria-labelledby="integration-title">
    <div class="container">
      <div class="integration-heading" data-reveal>
        <Eyebrow label="Simulator integration" />
        <h2 id="integration-title" class="section-title">Built around the flight, not around administration.</h2>
        <p class="section-lede">
          Pilot Journey adds structure and consequence before and after each flight, while Microsoft Flight Simulator
          remains where the actual flying happens.
        </p>
      </div>

      <ol class="integration-sequence">
        {integrationSteps.map((step) => (
          <li data-reveal>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>

      <div class="sim-support" data-reveal>
        <span>SUPPORTED SIMULATOR VERSIONS</span>
        <div>
          <b>Microsoft Flight Simulator <strong>2020</strong></b>
          <i aria-hidden="true"></i>
          <b>Microsoft Flight Simulator <strong>2024</strong></b>
        </div>
      </div>
    </div>
  </section>

  <section class="section audience-section" aria-labelledby="audience-title">
    <div class="container audience-grid">
      <div data-reveal>
        <span class="large-index">FOR / 01</span>
        <h2 id="audience-title" class="section-title">For pilots who want every flight to mean something.</h2>
      </div>

      <div class="audience-copy" data-reveal>
        <ul>
          {audiences.map((audience, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span>{audience}</li>
          ))}
        </ul>
        <p>
          Pilot Journey gives direction to the next flight and meaning to the flights already completed.
        </p>
      </div>
    </div>
  </section>

  <section class="section principles-section" aria-labelledby="principles-title">
    <div class="container">
      <div class="principles-heading" data-reveal>
        <Eyebrow label="Product principles" />
        <h2 id="principles-title" class="section-title">Designed as a career record, not a score screen.</h2>
      </div>

      <div class="principles-list">
        {productPrinciples.map((principle, index) => (
          <article data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="launch-access" class="section launch-section passport-grid" aria-labelledby="launch-title">
    <div class="container launch-grid">
      <div class="launch-copy" data-reveal>
        <Eyebrow label="Launch access" light />
        <h2 id="launch-title" class="section-title">Prepare for departure.</h2>
        <p class="section-lede">
          Join the launch list for development updates, early access information and launch availability.
        </p>
        <LaunchListForm />
      </div>

      <div class="launch-dossier" data-reveal aria-hidden="true">
        <div><span>ACCESS FILE</span><b>PJ-001</b></div>
        <strong>LAUNCH<br />MANIFEST</strong>
        <dl>
          <div><dt>PRODUCT</dt><dd>PILOT JOURNEY</dd></div>
          <div><dt>STATUS</dt><dd>PRE-DEPARTURE</dd></div>
          <div><dt>PRICING</dt><dd>TO BE ANNOUNCED</dd></div>
        </dl>
        <small>NO PAYMENT REQUIRED TO JOIN</small>
      </div>
    </div>
  </section>

  <section id="faq" class="section faq-section" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="faq-heading" data-reveal>
        <Eyebrow label="Flight desk / FAQ" />
        <h2 id="faq-title" class="section-title">Before you report for duty.</h2>
        <p class="section-lede">Clear answers based on what is confirmed today.</p>
      </div>

      <div class="faq-list" data-reveal>
        {faqItems.map((item) => (
          <FaqItem question={item.question}><p>{item.answer}</p></FaqItem>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta passport-grid" aria-labelledby="final-title">
    <div class="final-aircraft" aria-hidden="true">✈</div>
    <div class="container final-grid">
      <div class="final-copy" data-reveal>
        <span>YOUR NEXT OPERATION IS WAITING</span>
        <h2 id="final-title" class="section-title">Build the career behind every flight.</h2>
        <p class="section-lede">
          Join the Pilot Journey launch list and be among the first to enter the operations console.
        </p>
        <Button href="#launch-access" variant="primary" arrow>Join the launch list</Button>
      </div>

      <div class="next-operation-card" data-reveal>
        <div class="operation-card-head"><span>NEXT OPERATION</span><b>PJ / 001</b></div>
        <strong>CAREER<br />DEPARTURE</strong>
        <div class="clearance-line"><span>STATUS</span><b>AWAITING CLEARANCE</b></div>
        <div class="operation-codes"><span>CAREER</span><i>→</i><span>LEFT SEAT</span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const heroVisual = document.querySelector<HTMLElement>("[data-hero-visual]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (heroVisual && !reduceMotion.matches) {
    window.addEventListener(
      "scroll",
      () => {
        const offset = Math.min(window.scrollY * 0.018, 10);
        heroVisual.style.setProperty("--hero-shift", `${offset}px`);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 870px;
    padding: 138px 0 72px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-passport-line);
    color: var(--color-passport-fg);
    background:
      radial-gradient(circle at 78% 20%, rgba(194, 58, 87, 0.1) 0 11%, transparent 11.2%),
      linear-gradient(112deg, #052d4e 0%, #073a63 58%, #052c4c 100%);
  }

  .hero-aircraft {
    position: absolute;
    z-index: 0;
    right: 5%;
    top: 105px;
    color: rgba(2, 24, 43, 0.2);
    font-size: clamp(7rem, 10vw, 11rem);
    line-height: 1;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .hero::after {
    position: absolute;
    z-index: 0;
    width: 620px;
    height: 620px;
    right: -310px;
    bottom: -420px;
    content: "";
    border: 1px solid rgba(124, 192, 234, 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 78px rgba(124, 192, 234, 0.025),
      0 0 0 156px rgba(124, 192, 234, 0.018);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(580px, 1.12fr) minmax(500px, 0.88fr);
    gap: 18px;
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-brand {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin-top: 20px;
  }

  .hero h1 {
    display: grid;
    max-width: 680px;
    margin: 0;
    color: var(--color-passport-fg);
    font-family: var(--font-code);
    font-size: clamp(6.35rem, 7.35vw, 8.1rem);
    font-weight: 600;
    line-height: 0.76;
    letter-spacing: -0.037em;
    text-transform: uppercase;
  }

  .hero h1 span,
  .hero h1 strong {
    display: block;
  }

  .hero h1 strong {
    font-weight: 700;
  }

  .hero-route-detail {
    position: relative;
    width: min(92%, 570px);
    height: 17px;
    margin-top: 17px;
    overflow: hidden;
  }

  .hero-route-detail::before {
    position: absolute;
    width: calc(100% - 12px);
    height: 2px;
    left: 0;
    top: 7px;
    content: "";
    background: var(--color-danger);
    transform-origin: left center;
    animation: hero-route-draw 420ms ease-out 330ms both;
  }

  .hero-route-detail::after {
    position: absolute;
    width: 9px;
    height: 9px;
    right: 3px;
    top: 3px;
    content: "";
    border-top: 2px solid var(--color-danger);
    border-right: 2px solid var(--color-danger);
    transform: rotate(45deg);
  }

  .hero-payoff {
    max-width: 610px;
    margin: 23px 0 0;
    color: var(--color-passport-fg);
    font-size: clamp(2.15rem, 2.55vw, 2.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.042em;
  }

  .final-aircraft {
    position: absolute;
    color: rgba(2, 26, 47, 0.36);
    font-size: 4rem;
    line-height: 1;
    pointer-events: none;
  }

  .hero-lede {
    max-width: 560px;
    margin: 21px 0 28px;
    color: var(--color-passport-muted);
    font-size: clamp(1rem, 1.25vw, 1.14rem);
  }

  .hero-manifest {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 38px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--color-passport-line);
  }

  .hero-manifest div {
    display: grid;
    gap: 4px;
    padding: 0 18px;
    border-right: 1px solid var(--color-passport-line);
  }

  .hero-manifest div:first-child {
    padding-left: 0;
  }

  .hero-manifest div:last-child {
    border-right: 0;
  }

  .hero-manifest dt {
    color: var(--color-passport-faint);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-manifest dd {
    margin: 0;
    color: var(--color-passport-fg);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero-visual {
    position: relative;
    z-index: 1;
    min-height: 620px;
    margin-right: -88px;
    transform: translateY(var(--hero-shift, 0));
    transition: transform 120ms linear;
    animation: hero-interface-in 620ms ease-out 280ms both;
  }

  .app-frame {
    position: absolute;
    z-index: 1;
    width: min(760px, 124%);
    right: -48px;
    top: 72px;
    overflow: hidden;
    border: 1px solid rgba(124, 192, 234, 0.34);
    border-radius: 18px;
    background: var(--color-elevated);
    box-shadow: 0 34px 80px -30px rgba(0, 20, 38, 0.85);
    transform: rotate(1.35deg);
    transition: transform 280ms ease;
  }

  .hero-visual:hover .app-frame {
    transform: rotate(0.7deg) translateY(-3px);
  }

  .window-bar,
  .console-bar {
    display: flex;
    height: 38px;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    color: var(--color-fg-subtle);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-elevated);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .window-bar > div,
  .console-bar > div {
    display: flex;
    gap: 5px;
  }

  .window-bar i,
  .console-bar i {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .window-bar i:first-child,
  .console-bar i:first-child {
    background: var(--color-danger);
  }

  .window-bar i:nth-child(2),
  .console-bar i:nth-child(2) {
    background: var(--color-warning);
  }

  .window-bar i:last-child,
  .console-bar i:last-child {
    background: var(--color-success);
  }

  .app-frame img {
    display: block;
    width: 100%;
  }

  .flight-slip {
    position: absolute;
    z-index: 3;
    right: -6px;
    bottom: 20px;
    width: 270px;
    padding: 17px 20px;
    color: var(--color-fg-body);
    border: 1px solid var(--color-border);
    border-radius: 14px;
