---
interface Props {
  size?: "header" | "hero" | "footer";
  eager?: boolean;
}

const { size = "header", eager = false } = Astro.props;
---

<span class:list={["brand-logo", `brand-logo-${size}`]}>
  <img
    src="/media/pilot-journey-logo.png"
    alt="Pilot Journey"
    width="1920"
    height="912"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
</span>

<style>
  .brand-logo {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1.62;
    overflow: hidden;
    background: #02182b;
  }

  img {
    position: absolute;
    width: 166%;
    max-width: none;
    height: auto;
    left: -8%;
    top: -13%;
  }

  .brand-logo-header {
    width: 174px;
    border-radius: 10px;
  }

  .brand-logo-hero {
    width: min(510px, 100%);
    border: 1px solid var(--color-passport-line);
    border-radius: 18px;
    box-shadow: var(--shadow-plate);
  }

  .brand-logo-footer {
    width: 220px;
    border-radius: 12px;
  }

  @media (max-width: 520px) {
    .brand-logo-header {
      width: 148px;
    }

    .brand-logo-hero {
      width: 100%;
    }
  }
</style>
