---
interface Props {
  index: string;
  title: string;
  copy: string;
  meta: string;
}

const { index, title, copy, meta } = Astro.props;
---

<article class="feature-ticket">
  <div class="ticket-top">
    <span class="ticket-index">{index}</span>
    <span class="ticket-meta">{meta}</span>
  </div>
  <div class="ticket-route" aria-hidden="true">
    <span></span><i></i><span></span>
  </div>
  <h3>{title}</h3>
  <p>{copy}</p>
  <a href="/features">Review briefing <span aria-hidden="true">↗</span></a>
</article>

<style>
  .feature-ticket {
    position: relative;
    min-height: 316px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-elevated);
    box-shadow: var(--shadow-paper);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .feature-ticket:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lift);
  }

  .feature-ticket::after {
    position: absolute;
    right: -11px;
    top: 78px;
    width: 20px;
    height: 20px;
    content: "";
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-canvas);
  }

  .ticket-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ticket-index {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--color-accent-fg);
    border-radius: 8px;
    background: var(--color-accent);
  }

  .ticket-route {
    display: flex;
    height: 30px;
    align-items: center;
    gap: 8px;
    margin: 28px 0 23px;
  }

  .ticket-route span {
    width: 7px;
    height: 7px;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
  }

  .ticket-route i {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--color-border-strong);
  }

  .ticket-route i::after {
    position: absolute;
    top: -2px;
    left: 54%;
    width: 30%;
    height: 5px;
    content: "";
    border-top: 1px solid var(--color-accent);
    transform: skewX(-24deg);
  }

  h3 {
    margin: 0;
    color: var(--color-fg-strong);
    font-size: 1.35rem;
    line-height: 1.15;
  }

  p {
    margin: 12px 0 0;
    color: var(--color-fg-muted);
    font-size: 0.94rem;
  }

  a {
    position: absolute;
    bottom: 24px;
    display: inline-flex;
    gap: 8px;
    color: var(--color-accent-bright);
    font-size: 0.83rem;
    font-weight: 700;
  }
</style>
