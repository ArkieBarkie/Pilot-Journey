---
import BrandIcon from "./BrandIcon.astro";
import { withBase } from "../utils/paths";
---

<footer class="site-footer passport-grid">
  <div class="container">
    <div class="footer-main">
      <div class="footer-intro">
        <div class="footer-brand">
          <BrandIcon size="header" />
          <div>
            <strong>Pilot Journey</strong>
            <span>Career operations</span>
          </div>
        </div>
        <h2>Build the career behind every flight.</h2>
        <p>A persistent career operations platform for Microsoft Flight Simulator.</p>
      </div>

      <div class="footer-links">
        <div>
          <span>Explore</span>
          <a href={withBase("/#features")}>Features</a>
          <a href={withBase("/#career")}>Career</a>
          <a href={withBase("/#launch-access")}>Pricing</a>
        </div>
        <div>
          <span>Operations</span>
          <a href={withBase("/support")}>Support</a>
          <a href={withBase("/#faq")}>FAQ</a>
          <a href={withBase("/contact")}>Contact</a>
        </div>
        <div>
          <span>Legal</span>
          <a href={withBase("/legal/privacy")}>Privacy</a>
          <a href={withBase("/legal/terms")}>Terms</a>
          <a href={withBase("/legal/eula")}>EULA</a>
        </div>
      </div>
    </div>

    <div class="footer-base">
      <p>© {new Date().getFullYear()} Pilot Journey. All rights reserved.</p>
      <p>
        Pilot Journey is an independent product for Microsoft Flight Simulator. Microsoft and Microsoft Flight
        Simulator are trademarks of the Microsoft group of companies.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 76px 0 32px;
    border-top: 1px solid var(--color-passport-line);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(440px, 1fr);
    gap: 80px;
    padding-bottom: 68px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .footer-brand > div {
    display: grid;
    line-height: 1.1;
  }

  .footer-brand strong {
    color: var(--color-passport-fg);
  }

  .footer-brand span {
    margin-top: 5px;
    color: var(--color-passport-faint);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-intro h2 {
    max-width: 510px;
    margin: 0;
    color: var(--color-passport-fg);
    font-size: clamp(2rem, 4vw, 3.55rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .footer-intro > p:last-child {
    max-width: 530px;
    margin: 20px 0 0;
    color: var(--color-passport-muted);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .footer-links div {
    display: grid;
    align-content: start;
    gap: 9px;
  }

  .footer-links span {
    margin-bottom: 5px;
    color: var(--color-passport-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .footer-links a {
    color: var(--color-passport-muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-passport-fg);
  }

  .footer-base {
    display: grid;
    grid-template-columns: auto minmax(0, 690px);
    gap: 40px;
    justify-content: space-between;
    padding-top: 24px;
    color: var(--color-passport-faint);
    border-top: 1px solid var(--color-passport-line);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.6;
  }

  .footer-base p {
    margin: 0;
  }

  @media (max-width: 850px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer-base {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 520px) {
    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
