---
interface Props {
  size?: "header" | "ticket";
  eager?: boolean;
}

const { size = "header", eager = false } = Astro.props;
---

<span class:list={["brand-icon", `brand-icon-${size}`]} aria-hidden="true">
  <img
    src="/media/pilot-journey-logo.png"
    alt=""
    width="1920"
    height="912"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
</span>

<style>
  .brand-icon {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(124, 192, 234, 0.42);
    background: #02182b;
    box-shadow: var(--shadow-plate);
  }

  img {
    position: absolute;
    width: 488%;
    max-width: none;
    height: auto;
    left: -316%;
    top: -71%;
  }

  .brand-icon-header {
    width: 44px;
    border-radius: 12px;
  }

  .brand-icon-ticket {
    width: 38px;
    border-radius: 10px;
  }
</style>
