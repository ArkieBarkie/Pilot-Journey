---
interface Props {
  size?: "header" | "hero" | "ticket";
}

const { size = "header" } = Astro.props;
---

<span class:list={["brand-icon", `brand-icon-${size}`]} aria-hidden="true"></span>

<style>
  .brand-icon {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(124, 192, 234, 0.42);
    background-color: #02182b;
    background-image: url("/media/pilot-journey-icon.png");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-plate);
  }

  .brand-icon-header {
    width: 48px;
    border-radius: 12px;
  }

  .brand-icon-hero {
    width: 74px;
    border-radius: 18px;
  }

  .brand-icon-ticket {
    width: 38px;
    border-radius: 10px;
  }
</style>
