---
interface Props {
  variant: "dashboard" | "market" | "contract" | "assignment" | "logbook";
  title: string;
}

const { variant, title } = Astro.props;
---

<div class:list={["operation-placeholder", `is-${variant}`]} data-product-module={variant}>
  <div class="placeholder-toolbar">
    <div><i></i><i></i><i></i></div>
    <span>PILOT JOURNEY / {variant.toUpperCase()}</span>
    <small>PRODUCT MODULE</small>
  </div>

  {
    variant === "dashboard" && (
      <div class="dashboard-ui">
        <aside>
          <b>PJ</b>
          {["DASHBOARD", "SCHEDULE", "LIVE FLIGHT", "LOGBOOK"].map((item) => <span>{item}</span>)}
        </aside>
        <div class="dashboard-main">
          <div class="placeholder-heading">
            <small>LIVE · IN PROGRESS</small>
            <strong>LIRF <i>→</i> LGZA</strong>
          </div>
          <div class="dashboard-panels">
            <article><small>CONTRACT</small><b>Vueling Airlines</b><span>A320 · EC-BYZ</span></article>
            <article><small>STATUS</small><b>In flight</b><span>VLG3342 · FL370</span></article>
            <article><small>CAREER</small><b>Level 38</b><span>Chief Pilot · C</span></article>
          </div>
        </div>
      </div>
    )
  }

  {
    variant === "market" && (
      <div class="market-ui">
        <div class="market-filter"><span>CHARTER BOARD</span><b>688 AVAILABLE</b></div>
        {[
          ["LIRF", "Rome → Pescara", "P28T · 94 NM", "$500"],
          ["LIRF", "Rome → Falconara", "M20T · 119 NM", "$550"],
          ["LIRF", "Rome → Olbia", "C172 · 135 NM", "$600"],
        ].map((row) => (
          <div class="market-row">
            <b>{row[0]}</b><span><strong>{row[1]}</strong><small>{row[2]}</small></span><i>{row[3]}</i>
          </div>
        ))}
      </div>
    )
  }

  {
    variant === "contract" && (
      <div class="contract-ui">
        <div class="contract-stamp">ACTIVE</div>
        <small>CONTRACT / CHIEF PILOT</small>
        <h3>Vueling Airlines</h3>
        <div class="contract-grid">
          <span>FLEET <b>A320 · A20N</b></span>
          <span>BASE <b>LEBL</b></span>
          <span>PAYOUT <b>3.34×</b></span>
          <span>STATUS <b>In service</b></span>
        </div>
        <div class="contract-sign">REVIEW TERMS <i>→</i></div>
      </div>
    )
  }

  {
    variant === "assignment" && (
      <div class="assignment-ui">
        <div class="assignment-top"><span>AIRLINE SCHEDULE · LEG 07</span><b>SELECTED</b></div>
        <div class="route-display">
          <div><small>ORIGIN</small><strong>LIRF</strong><span>ROME</span></div>
          <i><b>VLG3342</b><em></em><small>01H 45M</small></i>
          <div><small>DESTINATION</small><strong>LGZA</strong><span>ZAKYNTHOS</span></div>
        </div>
        <div class="assignment-meta"><span>A320 · EC-BYZ</span><span>$1,886</span><span>880 MILES</span></div>
      </div>
    )
  }

  {
    variant === "logbook" && (
      <div class="logbook-ui">
        <div class="logbook-head"><span>FLIGHT LOG</span><b>1H 26M BLOCK</b></div>
        {[
          ["08 JUL", "DEBUG1", "LXGB → DAAE", "01:26", "A−"],
        ].map((row) => (
          <div class="logbook-row">
            {row.map((cell, index) => index === 4 ? <i>{cell}</i> : <span>{cell}</span>)}
          </div>
        ))}
      </div>
    )
  }

  <span class="sr-label">{title}. Product interface module based on the current Pilot Journey app.</span>
</div>

<style>
  .operation-placeholder {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    color: var(--color-fg-body);
    border: 1px solid var(--color-border-strong);
    border-radius: 17px;
    background: #f7f4ec;
    box-shadow: var(--shadow-lift);
  }

  .placeholder-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    height: 42px;
    align-items: center;
    padding: 0 15px;
    color: var(--color-fg-subtle);
    border-bottom: 1px solid var(--color-border);
    background: #eeebe3;
    font-family: var(--font-mono);
    font-size: 0.51rem;
    letter-spacing: 0.09em;
  }

  .placeholder-toolbar > div {
    display: flex;
    gap: 5px;
  }

  .placeholder-toolbar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .placeholder-toolbar i:first-child {
    background: var(--color-danger);
  }

  .placeholder-toolbar small {
    justify-self: end;
    color: var(--color-danger-fg);
  }

  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .dashboard-ui {
    display: grid;
    min-height: 388px;
    grid-template-columns: 108px 1fr;
  }

  .dashboard-ui aside {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 24px 13px;
    color: var(--color-passport-muted);
    background: var(--color-passport);
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .dashboard-ui aside b {
    display: grid;
    width: 35px;
    height: 35px;
    margin-bottom: 24px;
    place-items: center;
    color: white;
    border: 1px solid var(--color-passport-line);
    border-radius: 9px;
    background: var(--color-accent);
  }

  .dashboard-ui aside span {
    padding: 8px 4px;
  }

  .dashboard-main {
    padding: 38px 34px;
  }

  .placeholder-heading {
    display: grid;
    gap: 8px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-border);
  }

  .placeholder-heading small,
  .dashboard-panels small,
  .contract-ui > small {
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .placeholder-heading strong {
    color: var(--color-fg-strong);
    font-family: var(--font-code);
    font-size: 2.5rem;
    line-height: 1;
  }

  .placeholder-heading i {
    color: var(--color-accent);
    font-style: normal;
  }

  .dashboard-panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 24px;
  }

  .dashboard-panels article {
    display: grid;
    min-height: 128px;
    align-content: space-between;
    padding: 17px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-elevated);
  }

  .dashboard-panels b,
  .dashboard-panels span {
    font-size: 0.74rem;
  }

  .market-ui {
    padding: 30px;
  }

  .market-filter,
  .market-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
  }

  .market-filter {
    grid-template-columns: 1fr auto;
    padding-bottom: 18px;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .market-filter b {
    color: var(--color-accent-bright);
  }

  .market-row {
    min-height: 84px;
    padding: 0 18px;
    border-top: 1px solid var(--color-border);
  }

  .market-row > b {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    color: var(--color-passport-fg);
    border-radius: 8px;
    background: var(--color-passport);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .market-row > span {
    display: grid;
  }

  .market-row small {
    color: var(--color-fg-subtle);
  }

  .market-row i {
    padding: 5px 8px;
    color: var(--color-accent-bright);
    border: 1px solid var(--color-ocean-100);
    border-radius: 5px;
    background: var(--color-ocean-50);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-style: normal;
  }

  .contract-ui {
    position: relative;
    width: calc(100% - 72px);
    min-height: 315px;
    margin: 36px;
    padding: 30px;
    border: 1px solid var(--color-border);
    background: var(--color-elevated);
    box-shadow: var(--shadow-paper);
  }

  .contract-ui h3 {
    margin: 8px 0 28px;
    color: var(--color-fg-strong);
    font-size: 1.55rem;
  }

  .contract-stamp {
    position: absolute;
    right: 22px;
    top: 22px;
    padding: 5px 9px;
    color: var(--color-danger-fg);
    border: 1px solid rgba(194, 58, 87, 0.35);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    transform: rotate(2deg);
  }

  .contract-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 30px;
  }

  .contract-grid span {
    display: grid;
    gap: 5px;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.53rem;
  }

  .contract-grid b {
    color: var(--color-fg-strong);
    font-size: 0.78rem;
  }

  .contract-sign {
    margin-top: 28px;
    padding-top: 14px;
    color: var(--color-accent-bright);
    border-top: 1px dashed var(--color-border-strong);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .contract-sign i {
    font-style: normal;
  }

  .assignment-ui {
    padding: 30px;
  }

  .assignment-top,
  .assignment-meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.08em;
  }

  .assignment-top b {
    color: var(--color-success-bright);
  }

  .route-display {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    align-items: center;
    margin: 42px 0;
  }

  .route-display > div {
    display: grid;
    text-align: center;
  }

  .route-display small,
  .route-display span {
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .route-display strong {
    margin: 10px 0;
    color: var(--color-fg-strong);
    font-family: var(--font-code);
    font-size: 3.2rem;
    line-height: 1;
  }

  .route-display > i {
    position: relative;
    display: grid;
    align-items: center;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    font-style: normal;
    text-align: center;
  }

  .route-display em {
    display: block;
    height: 1px;
    margin: 12px 0;
    background: var(--color-ocean-300);
  }

  .route-display em::after {
    position: absolute;
    right: 0;
    top: 33px;
    width: 7px;
    height: 7px;
    content: "";
    border-top: 1px solid var(--color-accent);
    border-right: 1px solid var(--color-accent);
    transform: rotate(45deg);
  }

  .assignment-meta {
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }

  .logbook-ui {
    padding: 30px;
  }

  .logbook-head,
  .logbook-row {
    display: grid;
    grid-template-columns: 0.8fr 0.8fr 1.5fr 0.7fr 0.9fr;
    gap: 12px;
    align-items: center;
    font-family: var(--font-mono);
  }

  .logbook-head {
    grid-template-columns: 1fr auto;
    padding-bottom: 20px;
    color: var(--color-fg-subtle);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
  }

  .logbook-head b {
    color: var(--color-accent-bright);
  }

  .logbook-row {
    min-height: 62px;
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    font-size: 0.62rem;
  }

  .logbook-row i {
    color: var(--color-success-bright);
    font-style: normal;
  }

  @media (max-width: 680px) {
    .operation-placeholder {
      min-height: 360px;
    }

    .placeholder-toolbar {
      grid-template-columns: 1fr auto;
    }

    .placeholder-toolbar > span {
      display: none;
    }

    .dashboard-ui {
      min-height: 318px;
      grid-template-columns: 70px 1fr;
    }

    .dashboard-main {
      padding: 24px 18px;
    }

    .dashboard-panels {
      grid-template-columns: 1fr;
    }

    .dashboard-panels article:nth-child(n + 2) {
      display: none;
    }

    .market-ui,
    .assignment-ui,
    .logbook-ui {
      padding: 22px 18px;
    }

    .contract-ui {
      width: calc(100% - 36px);
      margin: 20px 18px;
      padding: 24px 20px;
    }

    .route-display strong {
      font-size: 2rem;
    }

    .route-display {
      grid-template-columns: 1fr 0.72fr 1fr;
    }

    .logbook-head,
    .logbook-row {
      grid-template-columns: 0.8fr 1fr 1.4fr;
    }

    .logbook-row > :nth-child(n + 4) {
      display: none;
    }
  }
</style>
