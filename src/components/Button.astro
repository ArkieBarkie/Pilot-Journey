---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  arrow?: boolean;
}

const { href, variant = "primary", arrow = false } = Astro.props;
---

<a class:list={["button", `button-${variant}`]} href={href}>
  <slot />
  {arrow && <span aria-hidden="true">↗</span>}
</a>
