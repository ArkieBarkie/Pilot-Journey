---
import { withBase } from "../utils/paths";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  arrow?: boolean;
}

const { href, variant = "primary", arrow = false } = Astro.props;
const resolvedHref = withBase(href);
---

<a class:list={["button", `button-${variant}`]} href={resolvedHref}>
  <slot />
  {arrow && <span aria-hidden="true">↗</span>}
</a>
