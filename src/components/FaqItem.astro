---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="faq-item">
  <summary>
    <span>{question}</span>
    <i aria-hidden="true"></i>
  </summary>
  <div class="faq-answer"><slot /></div>
</details>

<style>
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    min-height: 74px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 18px 0;
    color: var(--color-fg-strong);
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  summary i::before,
  summary i::after {
    position: absolute;
    top: 8px;
    left: 2px;
    width: 14px;
    height: 2px;
    content: "";
    background: var(--color-accent);
    transition: transform 150ms ease;
  }

  summary i::after {
    transform: rotate(90deg);
  }

  details[open] summary i::after {
    transform: rotate(0deg);
  }

  .faq-answer {
    max-width: 760px;
    padding: 0 38px 24px 0;
    color: var(--color-fg-muted);
  }

  .faq-answer :global(p) {
    margin: 0;
  }
</style>
