---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  updated?: string;
}

const { title, eyebrow, description, updated = "Draft / 23 July 2026" } = Astro.props;
---

<BaseLayout title={`${title} | Pilot Journey`} description={description}>
  <PageHero eyebrow={`Legal file / ${eyebrow}`} title={title} lede={description} />
  <section class="section">
    <article class="container legal-copy">
      <p class="legal-note">STATUS: {updated}. This page is a working product placeholder and is not final legal advice.</p>
      <slot />
    </article>
  </section>
</BaseLayout>
